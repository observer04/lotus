{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schemaVersion","harnessVersion","source","nodeVersion","commands","writableGlobs"],
  "properties":{
    "schemaVersion":{"const":1},
    "harnessVersion":{"type":"string"},
    "source":{"type":"object","required":["kind","identity"],"properties":{"kind":{"enum":["local","git"]},"identity":{"type":"string","minLength":1},"resolvedCommit":{"type":"string","minLength":1}}},
    "importedAt":{"type":"string","format":"date-time"},
    "nodeVersion":{"type":"string"},
    "framework":{"type":"string"},
    "commands":{"type":"object","required":["build","dev","typecheck","lint"],"properties":{"build":{"$ref":"#/$defs/argv"},"dev":{"$ref":"#/$defs/argv"},"typecheck":{"$ref":"#/$defs/argv"},"lint":{"$ref":"#/$defs/argv"},"e2e":{"$ref":"#/$defs/argv"}}},
    "writableGlobs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "unownedGlobs":{"type":"array","items":{"type":"string","minLength":1}},
    "serverReadyTimeoutMs":{"type":"number","minimum":0}
  },
  "$defs":{
    "argv":{"type":"array","minItems":1,"items":{"type":"string"}}
  }
}
