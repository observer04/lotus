{
  "schemaVersion": 1,
  "maxFileBytes": 1048576,
  "patterns": [
    {"id":"PRIVATE_KEY","regex":"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"},
    {"id":"OPENAI_KEY","regex":"\\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{20,}\\b"},
    {"id":"OPENROUTER_KEY","regex":"\\bsk-or-v1-[A-Fa-f0-9]{32,}\\b"},
    {"id":"GOOGLE_API_KEY","regex":"\\bAIza[A-Za-z0-9_-]{30,}\\b"},
    {"id":"GITHUB_TOKEN","regex":"\\bgh[pousr]_[A-Za-z0-9]{30,}\\b"},
    {"id":"AWS_ACCESS_KEY","regex":"\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b"},
    {"id":"SLACK_TOKEN","regex":"\\bxox[baprs]-[A-Za-z0-9-]{20,}\\b"},
    {"id":"STRIPE_SECRET","regex":"\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{20,}\\b"},
    {"id":"NAMED_SECRET_LITERAL","regex":"\\b(?:[A-Z][A-Z0-9_]*(?:API_KEY|SECRET|TOKEN|PASSWORD)|password|apiKey|api_key|secret|token)\\s*[:=]\\s*[\\\"'](?!\\$\\{|process\\.env|<|your[-_ ]|example|changeme|dummy|placeholder)([^\\\"'\\r\\n]{16,})[\\\"']","flags":"i"}
  ]
}
